{
      "input": "output_dir/model.onnx",
      "output_dir": "vad_axmodel",
      "output_name": "vad.axmodel",
    "model_type": "ONNX",
    "npu_mode": "NPU3",
    "target_hardware": "AX650",
    "quant": {
      "input_configs": [
        {
          "tensor_name": "speech",
          "calibration_dataset": "./datasets/speech.tar.gz",
          "calibration_format": "Numpy",
          "calibration_size": -1
        },
        {
          "tensor_name": "in_cache0",
          "calibration_dataset": "./datasets/in_cache0.tar.gz",
          "calibration_format": "Numpy",
          "calibration_size": -1
        },
        {
          "tensor_name": "in_cache1",
          "calibration_dataset": "./datasets/in_cache1.tar.gz",
          "calibration_format": "Numpy",
          "calibration_size": -1
        },
		{
          "tensor_name": "in_cache2",
          "calibration_dataset": "./datasets/in_cache2.tar.gz",
          "calibration_format": "Numpy",
          "calibration_size": -1
        },
		{
          "tensor_name": "in_cache3",
          "calibration_dataset": "./datasets/in_cache3.tar.gz",
          "calibration_format": "Numpy",
          "calibration_size": -1
        }
      ],
      "layer_configs": [
          {
          "start_tensor_names": ["DEFAULT"],
          "end_tensor_names": ["DEFAULT"],
          "data_type": "U16"
          },
          // {
          // "op_types": ["MatMul", "FullyConnected"],
          // "data_type": "S16"
          // }
      ],
      "calibration_method": "MinMax",
      "enable_smooth_quant": true,
      "conv_bias_data_type": "FP32",
      "disable_auto_refine_scale": true,
      "precision_analysis": true,
      "precision_analysis_method": "EndToEnd",
      "transformer_opt_level": 1
    },
    "compiler": {
      "check": 0
    }
  }
  
  